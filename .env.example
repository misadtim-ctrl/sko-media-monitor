# Google Apps Script bridge. No paid API keys are used.
APPS_SCRIPT_WEBHOOK_URL=
MONITOR_WEBHOOK_SECRET=

# The bot token stays in Apps Script. These are optional for direct Python delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MAIN_CHAT_ID=
TELEGRAM_NEGATIVE_CHAT_ID=

# Existing Instagram account, used only to load a reusable session.
INSTAGRAM_USERNAME=
INSTAGRAM_SESSION_FILE=data/instagram-session
INSTAGRAM_PROFILES_PER_RUN=32
INSTAGRAM_POSTS_PER_PROFILE=8

# Городские паблики собираются только на Mac: Instagram отвечает 429 любому
# адресу дата-центра. В GitHub Actions поэтому стоит INSTAGRAM_ENABLED=false.
INSTAGRAM_ENABLED=true
# Лента подписок — один запрос вместо обхода двух десятков профилей, поэтому
# опрашивать можно раз в 10 минут, а не раз в час.
INSTAGRAM_USE_FEED=true
INSTAGRAM_FEED_PAGES=3
# Страховка от ранжирования ленты: столько профилей за прогон проверяется
# поштучно, по очереди. Весь список обходится примерно за два часа.
INSTAGRAM_SWEEP_PROFILES=2

# Optional official free Meta path for Business/Creator profiles.
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v22.0

ENABLE_SEMANTIC=false
ENABLE_MEDIA_ANALYSIS=false
ENABLE_VIDEO_ANALYSIS=false
CONCURRENCY=8
REQUEST_TIMEOUT=25
